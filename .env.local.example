# ══════════════════════════════════════════════════════════════════════════════
# v5 — NEW PRODUCTS (Post-Encounter 697 · SOL 1997 · All-in-One Bundle)
# ══════════════════════════════════════════════════════════════════════════════
# SUNYL is now the SAME product as Lifegroup Essentials (397). The old
# *_SUNYL variables still work as a fallback for Lifegroup, so nothing breaks.
#
# Catalog prices (what the UI shows and what Google/Meta/TikTok receive):
#   Fundamentals 597 · Pre-Encounter 297 · Lifegroup 397 · Encounter 997 ·
#   Post-Encounter 697 · SOL 1997 · Bundle (sample limited-time price) 2997
# The backend price-scan threshold is computed AUTOMATICALLY from these numbers
# — change a price here and the accepted receipt range re-computes by itself.

NEXT_PUBLIC_PRODUCT_SOL_PRICE=1997
PRODUCT_FILE_URL_SOL=PASTE_SOL_MEDIAFIRE_LINK_HERE
NEXT_PUBLIC_DOWNLOAD_PAGE_URL_SOL=https://jhericojohnbalasa.systeme.io/sol-truth
NEXT_PUBLIC_AFFILIATE_LINK_SOL=https://jhericojohnbalasa.systeme.io/sol-truth

# Bundle: ONE zip with everything (PRODUCT_FILE_URL_BUNDLE). If you leave it as
# PASTE_…, buying the bundle downloads each configured product file instead.
NEXT_PUBLIC_PRODUCT_BUNDLE_PRICE=2997
PRODUCT_FILE_URL_BUNDLE=PASTE_BUNDLE_MEDIAFIRE_LINK_HERE
NEXT_PUBLIC_DOWNLOAD_PAGE_URL_BUNDLE=https://jhericojohnbalasa.systeme.io/bundle-truth
NEXT_PUBLIC_AFFILIATE_LINK_BUNDLE=https://jhericojohnbalasa.systeme.io/bundle-truth
# Optional countdown on the bundle page (ISO date). Leave empty for no timer.
NEXT_PUBLIC_BUNDLE_OFFER_ENDS=


# ══════════════════════════════════════════════════════════════════════════════
# v5 — HYBRID PAYMENTS (GCash primary + banks/e-wallets bridged via InstaPay)
# ══════════════════════════════════════════════════════════════════════════════
# Channels shown + accepted, in display order (GCash is always on and first).
# ROTATE channels by editing this list — no code change needed.
# Ids: gcash,maya,instapay,security_bank,maribank,bpi,gotyme,bdo,unionbank
NEXT_PUBLIC_PAYMENT_CHANNELS_ENABLED=gcash,maya,instapay,security_bank,maribank,bpi,gotyme,bdo,unionbank

# Receiving-account identifiers the receipt MUST show (any ONE matching passes).
# Comma separated. Add a NEW token to rotate to a new account; keep the old one
# until old receipts stop arriving.  Formats understood:
#   4PDO                 tail of the InstaPay/QRPh account number
#   JH****O JO*N B.      masked name as banks print it (OCR-tolerant)
#   09977963079          mobile number (matched on its last 7 digits)
PAYMENT_DEST_TOKENS=4PDO,JH****O JO*N B.,09977963079,J. Balasa
# strict = reject receipts that do not show our account (default when tokens set)
# warn   = accept but warn · off = skip
PAYMENT_DEST_CHECK=strict

# Optional: accept payments INSIDE another network (standalone), e.g. a Maya wallet of yours.
# PAYMENT_STANDALONE_ACCOUNTS={"maya":["09171234567"],"bpi":["1234567890"]}

# Backend price window = [price − PRICE_TOLERANCE , nearestRound(price) + RECEIPT_MAX_TRANSFER_FEE]
# e.g. 397 → 392–425. InstaPay sender fees run ₱0–₱25 (GCash ₱10 since 4 Jul 2026).
# The UI never shows this range.
RECEIPT_MAX_TRANSFER_FEE=25
RECEIPT_MAX_AGE_DAYS=3

# Fail CLOSED if Supabase is unreachable (default false = never strand a paying customer)
STRICT_DB=false
# Optional OCR model override: a folder containing eng.traineddata(.gz)
# OCR_LANG_PATH=./


